# OpenAI defaults used only by eval CLI runs. The Benchmark web page accepts
# a one-run URL/key/model override and never writes that key to disk.
EQUIPMENT_EVAL_OPENAI_BASE_URL=https://api.openai.com/v1
EQUIPMENT_EVAL_OPENAI_API_KEY=

# Alibaba Cloud Model Studio: Qwen-Deep-Research is currently available only
# in cn-beijing. Replace <WorkspaceId> with the Model Studio workspace ID.
EQUIPMENT_EVAL_DASHSCOPE_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1
EQUIPMENT_EVAL_DASHSCOPE_API_KEY=

# Zhipu AI OpenAI-compatible Chat Completions API. The default benchmark
# model is configurable in evals/config.yaml and can be overridden in the UI.
EQUIPMENT_EVAL_ZHIPU_BASE_URL=https://yunwu.ai/v1
EQUIPMENT_EVAL_ZHIPU_API_KEY=
