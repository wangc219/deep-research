# Copy this file to .env and fill in local values.
# Use "fake" for offline/demo runs or "real" for either real Agent adapter.
EQUIPMENT_DR_MODE=fake
# Real mode supports "codex" (Codex CLI Agent) and "responses" (custom Agent adapter).
EQUIPMENT_DR_PROVIDER=codex
EQUIPMENT_DR_MODEL=gpt-5.5
# 独立研究任务 Worker 数量。默认 4，可按机器和 API 限流情况配置为 1-8。
EQUIPMENT_DR_RESEARCH_WORKER_CONCURRENCY=4
EQUIPMENT_DR_CODEX_COMMAND=codex
# Optional root; each role receives its own isolated subdirectory below it.
# Defaults to <project>/outputs/runtime/codex-homes/<agent-id>.
EQUIPMENT_DR_CODEX_HOME=
# Optional independent authentication/config source for Codex CLI mode.
EQUIPMENT_DR_CODEX_SOURCE_HOME=
# API mode is the default Codex authentication path. The key value stays in the
# server-side environment; tasks only persist this environment-variable name.
EQUIPMENT_DR_CODEX_INHERIT_CONFIG=0
EQUIPMENT_DR_CODEX_PERFORMANCE_PROFILE=quality
# Global Codex-call scheduler. It starts at 6, reserves two slots for the
# current dependency wave, and adapts within 4-8 based on latency/errors.
EQUIPMENT_DR_CODEX_MODEL_CONCURRENCY=8
EQUIPMENT_DR_CODEX_MODEL_CONCURRENCY_MIN=4
EQUIPMENT_DR_CODEX_MODEL_CONCURRENCY_MAX=8
EQUIPMENT_DR_CODEX_RESERVED_PRIORITY_SLOTS=2
# Successful long-form reasoning is not treated as congestion. Enable only
# when the deployed gateway's latency reliably indicates rate saturation.
EQUIPMENT_DR_CODEX_LATENCY_DOWNSHIFT=0
# Keep breakthrough/gap reasoning high while running structured S4 mapping at
# medium effort; the final independent S6 capability synthesis remains high.
EQUIPMENT_DR_ENTERPRISE_LATENCY_PROFILE=1
# Lean loop policy: local schema/evidence gates run once; a model critic is
# invoked only after a material defect. Enable the two opt-ins only for special
# audits where the additional model latency is explicitly acceptable.
EQUIPMENT_DR_ENABLE_MODEL_LOOP_CRITICS=0
EQUIPMENT_DR_ENABLE_L4_MODEL_REPLAN=0
# 默认在制胜分析前前移执行能覆盖必需标签的蓝图补充角色，
# 避免完成主链后再外循环整段重跑。仅单角色隔离调试时设为 0。
EQUIPMENT_DR_PROMOTE_REQUIRED_BASELINE=1
EQUIPMENT_DR_CODEX_SLOW_CALL_SECONDS=150
EQUIPMENT_DR_CODEX_FAST_CALL_SECONDS=75
# Baseline map wave hard ceiling. This caps both discovery prefetch and Agent
# execution even when a blueprint places more roles in the same logical wave.
EQUIPMENT_DR_BASELINE_WAVE_CONCURRENCY=4
EQUIPMENT_DR_BASELINE_PREFETCH_WORKERS=8
EQUIPMENT_DR_DISCOVERY_MAX_BATCHES=2
EQUIPMENT_DR_MODEL_PROGRESS_INTERVAL_SECONDS=15
EQUIPMENT_DR_BASELINE_ANALYSIS_MAX_OUTPUT_TOKENS=4200
EQUIPMENT_DR_EQUIPMENT_ANALYSIS_MAX_OUTPUT_TOKENS=5200
EQUIPMENT_DR_REPORT_TIMEOUT_SECONDS=600
EQUIPMENT_DR_REPORT_RETRY_TIMEOUT_SECONDS=180
EQUIPMENT_DR_CODEX_BASE_URL=https://api.openai.com/v1
EQUIPMENT_DR_CODEX_API_KEY_ENV=EQUIPMENT_DR_CODEX_API_KEY
EQUIPMENT_DR_CODEX_API_KEY=
# Web discovery routing. Codex CLI custom gateways disable the hosted web_search
# tool, so real-mode discovery calls the Responses HTTPS endpoint directly by
# default (1). Set 0 only if your gateway lacks the Responses web_search tool.
EQUIPMENT_DR_DISCOVERY_VIA_RESPONSES=1
EQUIPMENT_DR_DISCOVERY_TIMEOUT_SECONDS=300
# Custom Agent / Responses configuration. Secrets stay in server-side environment variables.
EQUIPMENT_DR_API_KEY=
EQUIPMENT_DR_BASE_URL=https://api.openai.com/v1/responses
EQUIPMENT_DR_API_KEY_ENV=EQUIPMENT_DR_API_KEY
# Optional per-Agent overrides for either adapter.
# Example: {"orchestrator":{"provider":"codex","model":"gpt-5.5"},"winning_mechanism":{"provider":"responses","model":"custom-model","api_key_env":"WINNING_API_KEY"}}
EQUIPMENT_DR_AGENT_MODELS_JSON={}
# Incremental per-Agent navigation memory. Historical content is contextual only
# and must be revalidated and materialized in every real run.
EQUIPMENT_DR_AGENT_KNOWLEDGE_INDEX=outputs/knowledge/agent-knowledge-index.json
EQUIPMENT_DR_AGENT_KNOWLEDGE_MAX_RECORDS=300
EQUIPMENT_DR_SOURCE_PRIORITY_INDEX=outputs/knowledge/source-priority-index.json
# Evidence sufficiency uses count + independent domains + counterevidence.
EQUIPMENT_DR_EVIDENCE_ACCEPT_TARGET=4
EQUIPMENT_DR_EVIDENCE_MIN_COUNT=3
EQUIPMENT_DR_EVIDENCE_MIN_DOMAINS=2
# A role with at least one formal source may continue as a visibly limited,
# low-confidence handoff; zero formal sources still block the run.
EQUIPMENT_DR_ALLOW_LIMITED_BASELINE=1
# Opt in only when the execution environment maps verified public HTTPS hostnames
# to the RFC 2544 benchmark range (198.18.0.0/15). Literal benchmark IP URLs and
# HTTP remain blocked.
EQUIPMENT_DR_ALLOW_BENCHMARK_DNS_PROXY=0
# Optional HTTPS reader fallback for public pages that reject direct server-side fetches.
# The original source URL remains the evidence URL and the reader artifact is audited.
EQUIPMENT_DR_PUBLIC_READER_BASE_URL=https://r.jina.ai/http://
EQUIPMENT_DR_PUBLIC_READER_TIMEOUT_SECONDS=8
EQUIPMENT_DR_PUBLIC_READER_ATTEMPTS=1
EQUIPMENT_DR_EVIDENCE_PREWARM_LIMIT=6
EQUIPMENT_DR_EVIDENCE_PREWARM_CONCURRENCY=4

# Public browser configuration. Relative /api/v1 works with both Vite proxy and nginx.
VITE_API_BASE_URL=/api/v1
EQUIPMENT_DR_ENABLE_ABLATION=1

# Benchmark-only Zhipu GLM baseline. These credentials are isolated from the
# production research provider and are used only by evals/zhipu_llm.
EQUIPMENT_EVAL_ZHIPU_BASE_URL=https://yunwu.ai/v1
EQUIPMENT_EVAL_ZHIPU_API_KEY=
