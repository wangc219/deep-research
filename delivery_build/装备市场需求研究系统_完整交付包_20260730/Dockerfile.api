FROM node:22-bookworm-slim AS codex-cli
RUN npm install --global @openai/codex@0.144.4

FROM python:3.12-slim
WORKDIR /app
COPY --from=codex-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=codex-cli /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY configs ./configs
COPY evals ./evals
ENV PYTHONPATH=/app/src
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "equipment_deep_research.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
