# Runtime scratch and secret-bearing session state. Completed research outputs
# remain versioned; only local process/session state is excluded.
outputs/runtime/
outputs/runs/runtime/
# Codex homes contain local authentication and session state. They may also be
# nested inside captured run workspaces.
outputs/**/codex-home/
outputs/**/codex-homes/
outputs/**/auth.json
outputs/**/.env
outputs/**/.env.*
tmp/
*.db
*.db-shm
*.db-wal
*.log

# Local planning UI state
.superpowers/brainstorm/

# Platform fusion
web/dist/
web/.vite/
docker/volumes/
.migration-backup/
.deep-research/
# Legacy local state; migrated by scripts/migrate-environment.sh.
.yuxi/

# Generated research artifacts are committed. Local service databases and
# transient SQLite sidecars are rebuilt on each deployment.
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
outputs/application.db
outputs/query-library.db
outputs/research-queue.sqlite
outputs/model-call-outbox.db

# Per-run databases are part of the auditable research deliverable.
!outputs/**/run.db

# Migration-period third-party trees; not a product runtime dependency
reference/Yuxi-main/
reference/LibreChat-main/
reference/nanobot-main/

# 视频号模型缓存与桌面采集运行态
outputs/video-models/
outputs/video-collector/
video-collector.json
artifacts/wxchannels-migration-*/ssh-test-key*

backend/video_collector/bin/

# 公众号用户凭据、RSS token、下载与运行日志
/outputs/wechat-mp/
/backend/wechat_mp/data/

/outputs/collection-artifacts/

# 用户工作区和包含账号资料的一次性迁移包仅保留本机。
/user-data/
/chuangke-users-*/
/artifacts/chuangke-cloud-import-*/

# 发布压缩包和编译后的采集器可由已提交源码重建。
/artifacts/**/*.tar.gz
/artifacts/**/*.tgz
/artifacts/**/*.zip
/artifacts/cloud-wechat-collector-*/wx_video_download

# 历史终端重定向产生的空文件。
/ .Destination*
