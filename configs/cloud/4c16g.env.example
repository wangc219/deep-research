# 4 核 / 16 GB，面向多用户页面访问和 I/O 型持久任务；不包含凭据。
CLOUD_API_WORKERS=2
CLOUD_RESOURCE_GOVERNOR_ENABLED=true
CLOUD_DURABLE_MAX_RUNNING=20
CLOUD_ARQ_MAX_JOBS=24
CLOUD_SPLIT_AGENT_QUEUES=true
CLOUD_BACKGROUND_WORKER_KIND=background
COMPOSE_PROFILES=agent-pools
CLOUD_CHAT_MAX_JOBS=16
CLOUD_DEEP_AGENT_MAX_JOBS=4
CLOUD_SUBAGENT_MAX_JOBS=8
CLOUD_USER_CHAT_MAX_RUNNING=3
CLOUD_USER_DEEP_MAX_RUNNING=2
CLOUD_USER_SUBAGENT_MAX_RUNNING=4
CLOUD_API_POSTGRES_POOL_SIZE=8
CLOUD_API_POSTGRES_MAX_OVERFLOW=4
CLOUD_API_LANGGRAPH_POOL_SIZE=4
CLOUD_WORKER_POSTGRES_POOL_SIZE=12
CLOUD_WORKER_POSTGRES_MAX_OVERFLOW=4
CLOUD_WORKER_LANGGRAPH_POOL_SIZE=8
CLOUD_RESEARCH_POSTGRES_POOL_SIZE=4
CLOUD_RESEARCH_POSTGRES_MAX_OVERFLOW=2
CLOUD_RESEARCH_LANGGRAPH_POOL_SIZE=4
CLOUD_QUERY_POSTGRES_POOL_SIZE=4
CLOUD_QUERY_POSTGRES_MAX_OVERFLOW=2
CLOUD_QUERY_LANGGRAPH_POOL_SIZE=4
POSTGRES_MAX_CONNECTIONS=160
