# =============================================================================
# Equipment Deep Research — 统一本地环境模板
# -----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   填写各网关的 URL / API Key / 模型 ID
#   ./scripts/start-local.sh
#
# 文件分工（只需关心前两个）：
#   .env         部署配置 + 密钥（本文件复制而来，gitignored）
#   .env.local   仅 UI 写入的「本任务档案」选择，不含密钥
#   .env.codex*  旧版拆分文件，已弃用；若仍存在会作为兼容层叠加载
#
# 动态蜂群（winning_swarm）始终走 Codex CLI。换 GPT / DeepSeek / Queen /
# 中转站时：改下方对应区块的 MODEL + BASE_URL + API Key，并在 UI 选择
# model profile；不要把模型名写进代码或 agents.yaml。
# =============================================================================

# --- 运行模式 ---
EQUIPMENT_DR_MODE=real
EQUIPMENT_DR_PROVIDER=codex
EQUIPMENT_DR_EXECUTION_PROFILE_ID=winning_swarm_dynamic_v2

# --- 企业身份边界（生产环境推荐开启） ---
# 严格模式只接受反向代理注入的 X-Authenticated-* 身份声明；浏览器发送
# 的 X-Role/X-Tenant-ID 仅保留本地兼容用途，不能在严格模式下提升权限。
# 反向代理必须先剥离客户端同名 Header，再注入经过 OIDC/JWT 校验的声明。
# EQUIPMENT_DR_AUTH_MODE=trusted_headers
# EQUIPMENT_DR_REQUIRE_TRUSTED_IDENTITY=1

# --- Codex CLI 公共设置（所有 Codex 档案共用） ---
EQUIPMENT_DR_CODEX_COMMAND=codex
EQUIPMENT_DR_CODEX_HOME=
EQUIPMENT_DR_CODEX_SOURCE_HOME=
EQUIPMENT_DR_CODEX_INHERIT_CONFIG=0
EQUIPMENT_DR_CODEX_REASONING_EFFORT=medium
EQUIPMENT_DR_CODEX_PERFORMANCE_PROFILE=balanced
EQUIPMENT_DR_CODEX_TIMEOUT_SECONDS=900
# Independent final audit budget.  Keep enough room for an isolated model CLI
# cold start plus one structured response; set lower only for latency-critical
# deployments that accept a limited audit on timeout.
EQUIPMENT_DR_AUDIT_TIMEOUT_SECONDS=60
EQUIPMENT_DR_CODEX_RETRY_ATTEMPTS=2
EQUIPMENT_DR_CODEX_CAPACITY_RETRY_ATTEMPTS=4
EQUIPMENT_DR_CODEX_MODEL_CONCURRENCY=8
EQUIPMENT_DR_CODEX_MODEL_CONCURRENCY_MIN=4
EQUIPMENT_DR_CODEX_MODEL_CONCURRENCY_MAX=8
# Deployment-wide Codex CLI gate shared by API workers targeting the same
# workspace/model.  The gate may downshift after capacity refusals and
# recovers gradually after a clean window.
EQUIPMENT_DR_CODEX_MAX_CONCURRENCY=8
EQUIPMENT_DR_CODEX_MIN_CONCURRENCY=1
EQUIPMENT_DR_CODEX_GATE_BACKOFF_SECONDS=1.5
EQUIPMENT_DR_CODEX_GATE_BACKOFF_MAX_SECONDS=30
EQUIPMENT_DR_CODEX_GATE_BACKOFF_JITTER_SECONDS=0.4
EQUIPMENT_DR_S6_MODEL_CONCURRENCY_MAX=8
EQUIPMENT_DR_RESEARCH_WORKER_CONCURRENCY=2
EQUIPMENT_DR_S6_CODEX_CONCURRENCY=8

# =============================================================================
# 模型网关（按需填写；UI 按 model-profiles.yaml 选择）
# DeepSeek 官方地址直连 Responses；第三方中转地址自动启用本地 bridge。
# =============================================================================

# --- GPT / OpenAI 兼容（官方或中转站）→ profile: codex-gpt ---
# 动态蜂群默认使用这里的 MODEL + CODEX_BASE_URL。
EQUIPMENT_DR_MODEL=gpt-5.5
EQUIPMENT_DR_CODEX_BASE_URL=https://api.openai.com/v1
EQUIPMENT_DR_CODEX_API_KEY_ENV=EQUIPMENT_DR_CODEX_API_KEY
EQUIPMENT_DR_CODEX_API_KEY=
# 中转站示例：
# EQUIPMENT_DR_CODEX_BASE_URL=https://your-relay.example/v1
# EQUIPMENT_DR_MODEL=gpt-5.5

# --- 深度追问模型（可选） ---
# 默认全部留空：继承当前研究任务的 provider / model / URL /
# API Key 变量名。仅当深度追问需要独立模型或网关时填写。
EQUIPMENT_DR_DEEP_PROVIDER=
EQUIPMENT_DR_DEEP_MODEL=
EQUIPMENT_DR_DEEP_BASE_URL=
EQUIPMENT_DR_DEEP_API_KEY_ENV=
EQUIPMENT_DR_DEEP_REASONING_EFFORT=medium
EQUIPMENT_DR_DEEP_TIMEOUT_SECONDS=180
EQUIPMENT_DR_DEEP_CONTEXT_CHARS=14000

# --- 深研 MCP 宿主（可选） ---
# 仅该部署级文件可启动 MCP 连接；Plugin 内 mcp.json 始终只是声明。
# 相对路径按 EQUIPMENT_DR_PROJECT_ROOT 解析，修改后在下一轮自动热重载。
EQUIPMENT_DR_MCP_HOST_CONFIG=
# 示例：configs/equipment_deep_research/mcp-host.example.json
# HTTP header / stdio env 的秘密通过配置中的 *_from 字段引用环境变量。
EQUIPMENT_DR_RESEARCH_MCP_AUTHORIZATION=

# --- DeepSeek（Codex CLI）→ profile: codex-deepseek ---
# 官方 API 原生支持 Responses，无需 bridge。
EQUIPMENT_DR_DEEPSEEK_MODEL=deepseek-v4-flash
EQUIPMENT_DR_DEEPSEEK_BASE_URL=https://api.deepseek.com/
EQUIPMENT_DR_DEEPSEEK_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
# 中转站示例：
# EQUIPMENT_DR_DEEPSEEK_BASE_URL=https://your-relay.example/v1/chat/completions
# EQUIPMENT_DR_DEEPSEEK_MODEL=deepseek-v4-flash

# --- Queen / Qwen → profile: codex-queen ---
# 模型 ID、URL 和密钥统一由 env 注入；不要写入代码或 YAML 默认值。
EQUIPMENT_DR_QUEEN_MODEL=qwen3.8-flash
EQUIPMENT_DR_QUEEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EQUIPMENT_DR_QUEEN_API_KEY_ENV=QUEEN_API_KEY
QUEEN_API_KEY=

# --- 第三方 DeepSeek Chat Completions bridge 参数（通常无需修改） ---
# 当 DEEPSEEK_BASE_URL 不是 api.deepseek.com 时自动启动。
# EQUIPMENT_DR_BRIDGE_UPSTREAM_URL=https://your-relay.example/v1/chat/completions
# EQUIPMENT_DR_BRIDGE_MODEL=deepseek-v4-flash
# EQUIPMENT_DR_BRIDGE_API_KEY_ENV=DEEPSEEK_API_KEY
# EQUIPMENT_DR_BRIDGE_HOST=127.0.0.1
# EQUIPMENT_DR_BRIDGE_PORT=8787

# =============================================================================
# 动态蜂群模型路由（Codex CLI）
# 留空 {} = 继承当前任务所选 profile 的模型（推荐）。
# 仅在需要「同一任务内不同专家用不同模型」时填写。
# 键：archetype / runtime agent id / "*"；值：模型字符串或 {"model":"..."}
# =============================================================================
EQUIPMENT_DR_SWARM_AGENT_MODELS_JSON={}
EQUIPMENT_DR_AGENT_MODELS_JSON={}
# 示例（勿默认开启，以免把 DeepSeek/Queen 任务钉死在 GPT 模型名上）：
# EQUIPMENT_DR_SWARM_AGENT_MODELS_JSON={"weak_signal_scout":"gpt-5.5","*":"gpt-5.5"}

# --- Web / 前端 ---
VITE_API_BASE_URL=/api/v1
EQUIPMENT_DR_WEB_HOST=0.0.0.0
EQUIPMENT_DR_WEB_PORT=5173

# --- 常用可选项（保持默认即可） ---
EQUIPMENT_DR_DISCOVERY_VIA_RESPONSES=1
EQUIPMENT_DR_SEARCH_CONTEXT_SIZE_MODE=send
EQUIPMENT_DR_ALLOW_LIMITED_BASELINE=1
EQUIPMENT_DR_PUBLIC_READER_BASE_URL=https://r.jina.ai/http://
EQUIPMENT_DR_REPORTER_CHAPTER_FALLBACK=1
EQUIPMENT_DR_REPORTER_CHAPTER_FALLBACK_PROFILE=deepseek
