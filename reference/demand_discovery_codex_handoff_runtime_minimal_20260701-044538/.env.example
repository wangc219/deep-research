# Copy the variables you need into .env and fill local values.

$env:EXTRACTION_LLM_API_KEY="YOUR_API_KEY_HERE"
$env:EXTRACTION_LLM_BASE_URL="https://api.openai.com/v1"
$env:EXTRACTION_LLM_MODEL="gpt-5.5"
$env:EXTRACTION_LLM_REASONING_EFFORT="high"
$env:EXTRACTION_LLM_THINKING_ENABLED="false"
$env:EXTRACTION_LLM_JSON_MODE="true"
$env:EXTRACTION_LLM_TIMEOUT_SECONDS="240"
$env:EXTRACTION_LLM_TEMPERATURE="0"

$env:DEMAND_DISCOVERY_API_KEY="YOUR_API_KEY_HERE"
$env:DEMAND_DISCOVERY_BASE_URL="https://api.openai.com"
$env:DEMAND_DISCOVERY_MODEL="gpt-4.1-mini"
$env:DEMAND_DISCOVERY_ENDPOINT_MODE="responses_compatible"
$env:DEMAND_DISCOVERY_ENDPOINT_PATH=""
