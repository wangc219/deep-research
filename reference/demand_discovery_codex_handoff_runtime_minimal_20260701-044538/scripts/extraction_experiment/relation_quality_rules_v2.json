{
  "rule_version": "relation-quality-rules-v2",
  "path_safe_relation_types": [
    "enables",
    "supports",
    "implements",
    "applies_to",
    "drives",
    "has_capability"
  ],
  "context_only_relation_types": [
    "responsible_for",
    "contrasts_with",
    "similar_to",
    "measured_by"
  ],
  "needs_review_relation_types": [
    "evolves_to",
    "addresses",
    "impacts",
    "constrains",
    "indicates"
  ],
  "type_constraints": [
    {
      "relation_type": "has_capability",
      "target_type": "Capability",
      "message": "has_capability target is {target_type}, expected Capability"
    }
  ],
  "suspicious_type_patterns": [
    {
      "relation_type": "enables",
      "source_type": "RequirementGap",
      "target_type": "Technology",
      "suggested_relation_type": "drives",
      "message": "RequirementGap->Technology enables looks like drives"
    },
    {
      "relation_type": "applies_to",
      "source_type": "Source",
      "target_type": "EngineeringObject",
      "suggested_relation_type": "responsible_for",
      "message": "Source->EngineeringObject applies_to often needs responsible_for review"
    }
  ],
  "trigger_text_patterns": [
    {
      "relation_type": "enables",
      "contains_any": [
        "responsible for",
        "由",
        "负责"
      ],
      "suggested_relation_type": "responsible_for",
      "message": "enables evidence contains responsibility wording"
    },
    {
      "relation_type": "enables",
      "contains_any": [
        "has capability",
        "具备",
        "具有"
      ],
      "suggested_relation_type": "has_capability",
      "message": "enables evidence contains capability possession wording"
    }
  ]
}
